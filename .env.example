# Required. Create an API key in your provider dashboard and keep it private.
OPENAI_API_KEY=

# The model is configurable so you can choose one available to your account.
OPENAI_MODEL=gpt-6-astra

# App limits
MAX_QUESTION_CHARS=4000
MAX_OUTPUT_TOKENS=1400
REQUEST_TIMEOUT_SECONDS=90
MAX_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_RESEARCH=4

# Comma-separated additional literal phrases to block before contacting the model.
# A small built-in high-risk phrase list is always active; moderation remains the
# main filter because phrase matching can over-block or miss reworded requests.
BLOCKED_PHRASES=

# Comma-separated hostnames, for example: your-app.onrender.com
# Leave as * for local development; set this before public deployment.
ALLOWED_HOSTS=*
